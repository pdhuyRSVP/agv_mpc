# AMR serial devices. Install to /etc/udev/rules.d/99-amr-serial.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="f005860690886840a130a940aaad5155", GROUP:="dialout", MODE:="0660", SYMLINK+="amr_lidar"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="A5069RR4", GROUP:="dialout", MODE:="0660", SYMLINK+="amr_wheel"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", GROUP:="dialout", MODE:="0660", SYMLINK+="amr_imu"
