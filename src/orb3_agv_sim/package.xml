<?xml version="1.0"?>
<package format="3">
  <name>orb3_agv_sim</name>
  <version>1.0.0</version>
  <description>
    ORB-SLAM3 wrappers and launch files for the real AGV RGB-D camera stack.
  </description>

  <maintainer email="trongtuan@example.com">trongtuan</maintainer>
  <author email="trongtuan@example.com">trongtuan</author>
  <license>BSD</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ build dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>eigen</depend>
  <depend>gtsam</depend>
  <depend>opencv</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>

  <!-- Runtime dependencies -->
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
